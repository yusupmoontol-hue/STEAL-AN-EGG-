      end
      
      ratings[LocalPlayer.Name] = {
         Stars = starCount,
         Time = os.date("%d/%m/%Y %H:%M:%S"),
         Timestamp = os.time()
      }
      
      if writefile then
         writefile(ratingDatabasePath, HttpService:JSONEncode(ratings))
      end
   end)
end

